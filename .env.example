# Copy to .env for local Docker Compose. NEVER commit .env.
# Synthetic, local-only values. Real credentials live in GitHub Environment secrets / k3s Secrets.
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm-local-dev

# JWT signing key (HS256) - at least 32 characters. Generate your own: openssl rand -base64 48
APP_JWT_SECRET=local-dev-only-change-me-0123456789abcdef

# Demo logins for the Angular UI (usernames: agent, manager)
APP_DEMO_AGENT_PASSWORD=agent-local-dev
APP_DEMO_MANAGER_PASSWORD=manager-local-dev
